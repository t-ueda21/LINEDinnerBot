{
  "name": "line-dinner-bot",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test test/bot.test.ts",
    "smoke": "npm run build && node test/worker-smoke.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261121.1",
    "miniflare": "5.20261119.0-beta",
    "typescript": "7.0.2",
    "wrangler": "4.166.0"
  }
}
